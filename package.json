{
  "name": "kasir-warung",
  "version": "1.4.0",
  "description": "Aplikasi POS",
  "author": {
    "name": "Danzel Tampilang",
    "email": "danzeltampilang@gmail.com",
    "url": "https://wa.me/6289502417252"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "preelectron:dev": "node electron/free-port.cjs && node electron/kill-electron.cjs",
    "preelectron:plain": "node electron/free-port.cjs",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "npx @electron/rebuild -f -w node-hid",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && node electron/dev-runner.cjs\"",
    "electron:plain": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "node-hid": "^2.0.0",
    "node-machine-id": "^1.1.12",
    "node-thermal-printer": "^4.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "node-gyp": "^13.0.1",
    "vite": "^5.4.10",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.warung.kasir",
    "productName": "DEN POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "electron/license-secret.cjs",
      "node_modules/**/*",
      "package.json"
    ],
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DEN POS"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "better-sqlite3@11.8.1": true,
    "esbuild@0.21.5": true
  }
}
